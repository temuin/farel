---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { addressLine, contact, mapEmbedUrl, site } from '../config/site';
import { generalEnquiryUrl } from '../lib/whatsapp';

const details = [
  { label: 'WhatsApp / phone', value: contact.phoneDisplay, href: `tel:+${contact.whatsappNumber}` },
  { label: 'Email', value: contact.email, href: `mailto:${contact.email}` },
  { label: 'Address', value: addressLine },
  { label: 'Opening hours', value: contact.openingHours },
];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} on WhatsApp, by email or at our Jakarta office for Kelme and Adidas team orders.`}
>
  <section class="border-b border-neutral-200 bg-neutral-50">
    <div class="shell py-16 sm:py-20">
      <SectionHeading
        as="h1"
        eyebrow="Contact"
        title="Get in touch"
        description="WhatsApp is the fastest way to reach us during business hours. Send the product names and quantities you need and we will reply with a quote."
      />
      <div class="mt-8">
        <Button href={generalEnquiryUrl()} external>
          <WhatsAppIcon />
          Chat on WhatsApp
        </Button>
      </div>
    </div>
  </section>

  <section class="shell grid gap-12 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Company details</h2>
      <dl class="mt-8 space-y-6">
        {
          details.map((detail) => (
            <div>
              <dt class="text-xs font-semibold tracking-[0.2em] text-neutral-500 uppercase">
                {detail.label}
              </dt>
              <dd class="mt-2 text-base text-neutral-900">
                {detail.href ? (
                  <a href={detail.href} class="hover:text-accent-600">
                    {detail.value}
                  </a>
                ) : (
                  detail.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10 overflow-hidden rounded-2xl border border-neutral-200">
        <iframe
          src={mapEmbedUrl}
          title={`Map showing the ${site.name} office`}
          width="100%"
          height="320"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          style="border:0"></iframe>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Send an enquiry</h2>
      <p class="mt-3 text-base leading-relaxed text-neutral-600">
        Prefer email? Fill in the form and we will get back to you within one business day.
      </p>
      <div class="mt-8">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
