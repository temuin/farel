---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { getProducts, imageAlt, type Product } from '../../lib/products';
import { productEnquiryUrl } from '../../lib/whatsapp';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, brand, category, images, description } = product.data;
const { Content } = await render(product);

const [coverImage, ...secondaryImages] = images;
---

<BaseLayout title={name} description={description} image={coverImage.src}>
  <div class="shell py-10 sm:py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-zinc-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/collections" class="hover:text-zinc-900">Collections</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-zinc-900">{name}</li>
      </ol>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="space-y-4">
        <div class="aspect-square overflow-hidden rounded-2xl bg-zinc-100">
          <Image
            src={coverImage}
            alt={imageAlt(product, 0)}
            widths={[600, 1000]}
            sizes="(min-width: 1024px) 560px, 92vw"
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>

        {
          secondaryImages.length > 0 && (
            <ul class="grid grid-cols-3 gap-4">
              {secondaryImages.map((image, index) => (
                <li class="aspect-square overflow-hidden rounded-xl bg-zinc-100">
                  <Image
                    src={image}
                    alt={imageAlt(product, index + 1)}
                    widths={[200, 400]}
                    sizes="(min-width: 1024px) 180px, 30vw"
                    class="h-full w-full object-cover"
                  />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div>
        <div class="flex items-center gap-2 text-xs font-semibold tracking-wide uppercase">
          <span class="text-zinc-900">{brand}</span>
          <span aria-hidden="true" class="text-zinc-300">/</span>
          <span class="text-zinc-500">{category}</span>
        </div>

        <h1 class="mt-3 text-3xl font-bold tracking-tight text-balance text-zinc-900 sm:text-4xl">
          {name}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-zinc-600">{description}</p>

        <div
          class="mt-8 space-y-4 text-base leading-relaxed text-zinc-600 [&_strong]:text-zinc-900 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5"
        >
          <Content />
        </div>

        <div class="mt-10 rounded-2xl border border-zinc-200 bg-zinc-50 p-6">
          <p class="text-sm leading-relaxed text-zinc-600">
            Pricing depends on quantity and customisation. Send us this product name and we will
            come back with a quote and current stock.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <Button href={productEnquiryUrl(name)} external>
              <WhatsAppIcon />
              Inquire via WhatsApp
            </Button>
            <Button href="/contact" variant="secondary">Other ways to reach us</Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
