---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionFilter from '../../components/CollectionFilter.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getProducts, getUsedBrands, getUsedCategories, productUrl } from '../../lib/products';
import { breadcrumbs, itemList } from '../../lib/schema';
import { SPORTS } from '../../config/catalog';
import { site } from '../../config/site';

const products = await getProducts();
const brands = getUsedBrands(products);
const categories = getUsedCategories(products);

/*
 * The grid below is filtered client-side, so every product is in the markup
 * whatever the filter says -- which makes an ItemList of all of them an honest
 * description of the page rather than a snapshot of one filter state.
 */
const schema = [
  breadcrumbs([
    { name: 'Home', path: '/' },
    { name: 'Collections', path: '/collections/' },
  ]),
  itemList({
    name: 'Kelme and Adidas catalogue',
    items: products.map((entry) => ({ name: entry.data.name, path: productUrl(entry) })),
  }),
];
---

<BaseLayout
  title={`Kelme & Adidas Catalogue — ${site.legalName}`}
  appendSiteName={false}
  description="Browse the full Kelme and Adidas catalogue — apparel, footwear and accessories for clubs, schools and retailers in Indonesia."
  schema={schema}
>
  <section class="border-b border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900">
    <div class="shell py-16 sm:py-20">
      <SectionHeading
        as="h1"
        eyebrow="Catalogue"
        title="Collections"
        description="Filter by brand and category to find what you need, then send us the product name on WhatsApp for pricing and availability."
      />
    </div>
  </section>

  <section class="shell py-12 sm:py-16" data-catalog>
    <CollectionFilter brands={brands} categories={categories} sports={[...SPORTS]} total={products.length} />

    <div class="mt-8">
      <ProductGrid products={products} eagerCount={4} filterable />
    </div>

    <p data-empty-state hidden class="rounded-2xl border border-dashed border-neutral-300 p-12 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
      No products match this combination. Try clearing one of the filters.
    </p>
  </section>

  {
    /*
     * /collections/?brand=kelme and /collections/?brand=adidas serve the
     * exact same prerendered HTML as the plain page above -- CollectionFilter
     * applies the filter client-side -- and the <meta name="robots"> tag
     * from BaseLayout already ships as "index, follow" in that HTML. The
     * canonical tag correctly points every variant at /collections/, but
     * Search Console shows Google indexed /collections/?brand=kelme as its
     * own page anyway and never indexed /collections/ itself: rel=canonical
     * is only ever a hint, and Google evidently chose to ignore it here.
     * noindex is a directive it reliably obeys, so this pushes a filtered
     * URL out of the index the moment it's next crawled, while `follow`
     * keeps link equity flowing to the products it links to.
     *
     * This can only run in the browser: a static build has no request to
     * read a query string from, so every URL variant is, and must stay,
     * byte-for-byte the same file. Google does read a robots meta tag
     * changed by JavaScript before it finishes indexing a page.
     *
     * Deliberately NOT is:inline. Astro's CSP integration only computes a
     * script-src hash for scripts it bundles itself (the type="module"
     * scripts every other component on this page uses, e.g.
     * CollectionFilter's own script) -- an is:inline tag is never hashed, so
     * the browser silently drops it as a CSP violation. That turned out to
     * already be true of every is:inline script on the site (BaseLayout's
     * dark-mode script, both Google Ads snippets) -- reported separately,
     * since fixing those is outside this change. This script only needs to
     * exist in the page, not to run before paint, so the ordinary bundled
     * form works with no downside.
     */
  }
  <script>
    const FILTER_PARAMS = ['brand', 'category', 'sport'];
    const params = new URLSearchParams(location.search);
    if (FILTER_PARAMS.some((key) => params.has(key))) {
      const robots = document.querySelector('meta[name="robots"]');
      if (robots) robots.setAttribute('content', 'noindex, follow');
    }
  </script>
</BaseLayout>
