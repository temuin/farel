---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandStrip from '../components/BrandStrip.astro';
import Button from '../components/Button.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import SectionHeading from '../components/SectionHeading.astro';
import storefrontPhoto from '../assets/about/storefront.jpeg';
import warehousePhoto from '../assets/about/warehouse-shelving.jpeg';
import packingPhoto from '../assets/about/packing-quality-check.jpeg';
import { CATEGORIES, BRANDS } from '../config/catalog';
import { getProducts } from '../lib/products';
import { site } from '../config/site';
import { videoUrl } from '../config/site';

const products = await getProducts();
const yearsActive = new Date().getFullYear() - site.foundedYear;

const stats = [
  { value: `${yearsActive}+`, label: 'Years in business' },
  { value: String(BRANDS.length), label: 'Authorised brands' },
  { value: String(CATEGORIES.length), label: 'Product categories' },
  { value: String(products.length), label: 'Products in catalogue' },
];

const values = [
  {
    title: 'Authorised supply only',
    body: 'Every item we carry is sourced through the brands’ official distribution channels, with documentation available on request.',
  },
  {
    title: 'Stock held locally',
    body: 'Core lines are warehoused in Indonesia, so standard team orders ship without waiting on an overseas production run.',
  },
  {
    title: 'Built for team orders',
    body: 'Full size runs from youth to adult, plus crest, number and sponsor application handled in-house.',
  },
];
---

<BaseLayout
  title="About"
  description={`Company profile for ${site.legalName}, an authorised Indonesian distributor of Kelme and Adidas team sportswear.`}
>
  <section class="border-b border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900">
    <div class="shell grid gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <SectionHeading
          as="h1"
          eyebrow="Company profile"
          title={`About ${site.name}`}
          description={`Established in ${site.foundedYear}, we distribute Kelme and Adidas team sportswear to clubs, schools and retailers across Indonesia.`}
        />

        <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8">
          {
            stats.map((stat) => (
              <div>
                <dt class="text-3xl font-bold tracking-tight text-accent-600 dark:text-accent-500">{stat.value}</dt>
                <dd class="mt-1 text-xs font-medium tracking-wide text-neutral-500 uppercase dark:text-neutral-400">
                  {stat.label}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="aspect-[4/3] overflow-hidden rounded-2xl lg:aspect-[4/5]">
        <Image
          src={storefrontPhoto}
          alt={`The ${site.name} team at our Adidas storefront display`}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 40vw, 90vw"
          loading="eager"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="shell grid gap-12 py-16 sm:py-20 lg:grid-cols-2">
    <div class="space-y-5 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
      <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">Our story</h2>
      <p>
        {site.legalName} started as a small team-kit supplier and has spent the last {yearsActive}
        years growing into a national distributor for two performance sportswear brands. What began
        with local club orders now covers school programmes, futsal venues, sports retailers and
        corporate teams throughout the archipelago.
      </p>
      <p>
        Our focus has not changed: keep genuine product in stock, quote quickly, and get kit
        delivered before the season starts. Most of our customers come back each year, which means
        we plan our stock around real team calendars rather than seasonal guesswork.
      </p>
      <p>
        This is placeholder copy. Replace it with the company&rsquo;s own history, milestones and
        positioning before launch.
      </p>
    </div>

    <div class="flex flex-col gap-6">
      <MediaPlaceholder label="Warehouse or office interior" class="aspect-video" />

      <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8 dark:border-neutral-800 dark:bg-neutral-900">
        <h2 class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white">Official distributor statement</h2>
        <p class="mt-4 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
          {site.legalName} is an authorised distributor of Kelme and Adidas products for the
          Indonesian market. All goods we supply are genuine, sourced through official channels, and
          covered by the manufacturers&rsquo; standard warranty terms.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
          Placeholder wording. Confirm the exact distributor status, territory and any wording
          required by each brand before publishing.
        </p>
        <div class="mt-8">
          <Button href="/contact">Talk to our team</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-neutral-200 bg-neutral-50 py-16 sm:py-20 dark:border-neutral-800 dark:bg-neutral-900">
    <div class="shell">
      <SectionHeading
        eyebrow="Behind the scenes"
        title="Inside our operation"
        description="Where your order actually comes from — the warehouse, the packing bench and dispatch."
      />
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <div class="aspect-square overflow-hidden rounded-2xl">
          <Image
            src={warehousePhoto}
            alt="Stacked and labelled stock on warehouse shelving"
            widths={[300, 600]}
            sizes="(min-width: 640px) 34vw, 90vw"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-2xl">
          <Image
            src={packingPhoto}
            alt="Staff packing and quality-checking an order before dispatch"
            widths={[300, 600]}
            sizes="(min-width: 640px) 34vw, 90vw"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="aspect-square overflow-hidden rounded-2xl bg-black">
          <video
            class="h-full w-full object-cover"
            src={videoUrl("dispatch-delivery.mp4")}
            poster="/videos/dispatch-delivery-poster.jpg"
            aria-label="Orders being packed, labelled and dispatched from the Amalia Utama warehouse"
            autoplay
            muted
            loop
            playsinline
          />
        </div>
      </div>
    </div>
  </section>

  <section class="shell py-16 sm:py-20">
    <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">How we work</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        values.map((value, index) => (
          <li class="rounded-2xl border border-neutral-200 p-6 dark:border-neutral-800">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-50 text-sm font-bold text-accent-600 dark:bg-accent-500/10 dark:text-accent-500">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-base font-semibold text-neutral-900 dark:text-white">{value.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{value.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell pb-4">
    <SectionHeading
      eyebrow="Partner brands"
      title="The brands we represent"
      description="Both labels are supplied under the same terms, with a single account manager for your orders."
    />
    <div class="mt-12">
      <BrandStrip detailed />
    </div>
  </section>
</BaseLayout>
