---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandStrip from '../components/BrandStrip.astro';
import Button from '../components/Button.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import RemoteImage from '../components/RemoteImage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, videoUrl } from '../config/site';
import {
  aboutStats,
  brands,
  ceo,
  hero,
  howWeWork,
  operation,
  statement,
  statsTitle,
  story,
} from '../config/about';

/*
 * Every string and image below comes from src/data/about.json, edited in the
 * admin panel under Site content -> About page. Nothing on this page needs a
 * developer to change. What stays here is the layout, which is design rather
 * than content and would be easy to break by accident if it were editable.
 *
 * Optional images fall back to a labelled placeholder rather than collapsing
 * the grid, so a half-filled page still reads as deliberate while the client
 * is gathering photography.
 */
---

<BaseLayout
  title="About"
  description={`Company profile for ${site.legalName}, an authorised Indonesian distributor of Kelme and Adidas team sportswear.`}
>
  <section class="border-b border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-900">
    <div class="shell grid gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <SectionHeading
          as="h1"
          eyebrow={hero.eyebrow}
          title={hero.title}
          description={hero.description}
        />

        <h2 class="mt-10 text-lg font-bold tracking-tight text-neutral-900 dark:text-white">
          {statsTitle}
        </h2>

        <dl class="mt-6 divide-y divide-neutral-200 dark:divide-neutral-800">
          {
            aboutStats.map((stat) => (
              <div class="grid grid-cols-[auto_1fr] gap-x-5 py-5 first:pt-0 last:pb-0">
                <dt class="text-2xl font-bold tracking-tight text-accent-600 tabular-nums sm:text-3xl dark:text-accent-500">
                  {stat.value}
                </dt>
                <dd>
                  <p class="text-base font-semibold text-neutral-900 dark:text-white">{stat.label}</p>
                  <p class="mt-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{stat.body}</p>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="aspect-[4/3] overflow-hidden rounded-2xl lg:aspect-[4/5]">
        {
          hero.image ? (
            <RemoteImage
              src={hero.image}
              alt={hero.imageAlt}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              loading="eager"
              class="h-full w-full object-cover"
            />
          ) : (
            <MediaPlaceholder label="Company photo" class="h-full w-full" />
          )
        }
      </div>
    </div>
  </section>

  {
    /* Skipped entirely when no quote is set, rather than framing empty space. */
    ceo && (
      <section class="border-b border-neutral-200 dark:border-neutral-800">
        <div class="shell py-14 sm:py-16">
          <div class="flex flex-col gap-8 sm:flex-row sm:items-center">
            {ceo.photo && (
              /*
               * Through the optimiser rather than a plain <img>: this is a
               * photo somebody uploads from a phone, so the original is likely
               * to be a megabyte or two for a box rendered at 224px.
               */
              <div class="h-48 w-48 shrink-0 overflow-hidden rounded-2xl sm:h-56 sm:w-56">
                <RemoteImage
                  src={ceo.photo}
                  alt={ceo.name ? `${ceo.name}, ${ceo.role}` : ceo.role}
                  widths={[224, 448]}
                  sizes="224px"
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div>
              <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">
                {ceo.heading}
              </h2>
              <blockquote class="mt-4 max-w-2xl text-lg leading-relaxed text-neutral-700 dark:text-neutral-300">
                &ldquo;{ceo.quote}&rdquo;
              </blockquote>
              <p class="mt-4 text-sm font-semibold text-neutral-900 dark:text-white">
                {ceo.name && <span>{ceo.name}</span>}
                {ceo.name && <span aria-hidden="true" class="mx-2 text-neutral-300 dark:text-neutral-700">/</span>}
                <span class="font-medium text-neutral-500 dark:text-neutral-400">{ceo.role}</span>
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="shell grid gap-12 py-16 sm:py-20 lg:grid-cols-2">
    <div class="space-y-5 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
      <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">
        {story.heading}
      </h2>
      {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="flex flex-col gap-6">
      <div class="aspect-video overflow-hidden rounded-2xl">
        {
          story.image ? (
            <RemoteImage
              src={story.image}
              alt={story.imageAlt}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              class="h-full w-full object-cover"
            />
          ) : (
            <MediaPlaceholder label="Warehouse or office interior" class="h-full w-full" />
          )
        }
      </div>

      <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8 dark:border-neutral-800 dark:bg-neutral-900">
        <h2 class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white">
          {statement.heading}
        </h2>
        {
          statement.paragraphs.map((paragraph) => (
            <p class="mt-4 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
              {paragraph}
            </p>
          ))
        }
        {
          statement.buttonLabel && (
            <div class="mt-8">
              <Button href={statement.buttonHref}>{statement.buttonLabel}</Button>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="border-y border-neutral-200 bg-neutral-50 py-16 sm:py-20 dark:border-neutral-800 dark:bg-neutral-900">
    <div class="shell">
      <SectionHeading
        eyebrow={operation.eyebrow}
        title={operation.title}
        description={operation.description}
      />
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <div class="aspect-square overflow-hidden rounded-2xl">
          {
            operation.imageOne ? (
              <RemoteImage
                src={operation.imageOne}
                alt={operation.imageOneAlt}
                widths={[300, 600]}
                sizes="(min-width: 640px) 34vw, 90vw"
                class="h-full w-full object-cover"
              />
            ) : (
              <MediaPlaceholder label="Operations photo" class="h-full w-full" />
            )
          }
        </div>
        <div class="aspect-square overflow-hidden rounded-2xl">
          {
            operation.imageTwo ? (
              <RemoteImage
                src={operation.imageTwo}
                alt={operation.imageTwoAlt}
                widths={[300, 600]}
                sizes="(min-width: 640px) 34vw, 90vw"
                class="h-full w-full object-cover"
              />
            ) : (
              <MediaPlaceholder label="Operations photo" class="h-full w-full" />
            )
          }
        </div>
        <div class="aspect-square overflow-hidden rounded-2xl bg-black">
          {
            operation.videoFile ? (
              <video
                class="h-full w-full object-cover"
                src={videoUrl(operation.videoFile)}
                poster="/videos/dispatch-delivery-poster.jpg"
                aria-label={operation.videoAlt}
                autoplay
                muted
                loop
                playsinline
              />
            ) : (
              <MediaPlaceholder label="Operations video" class="h-full w-full" />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="shell py-16 sm:py-20">
    <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">
      {howWeWork.heading}
    </h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        howWeWork.items.map((item, index) => (
          <li class="rounded-2xl border border-neutral-200 p-6 dark:border-neutral-800">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-50 text-sm font-bold text-accent-600 dark:bg-accent-500/10 dark:text-accent-500">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-base font-semibold text-neutral-900 dark:text-white">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell pb-4">
    <SectionHeading
      eyebrow={brands.eyebrow}
      title={brands.title}
      description={brands.description}
    />
    <div class="mt-12">
      <BrandStrip detailed />
    </div>
  </section>
</BaseLayout>
