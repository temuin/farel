---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandShowcase from '../components/BrandShowcase.astro';
import Button from '../components/Button.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import CollectionPreview from '../components/CollectionPreview.astro';
import HeroPhotoWall from '../components/HeroPhotoWall.astro';
import LogoMarqueeBackdrop from '../components/LogoMarqueeBackdrop.astro';
import RemoteImage from '../components/RemoteImage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Testimonials from '../components/Testimonials.astro';
import { BRAND_PROFILES } from '../config/catalog';
import { getBrandPreviews, getProducts } from '../lib/products';
import { site } from '../config/site';
import {
  TILE_ASPECT,
  closing,
  collections,
  gallery,
  hero,
  highlights,
  stories,
  trusted,
} from '../config/home';

const previews = await getBrandPreviews();
const products = await getProducts();

/** Matches the crossfade classes BrandShowcase uses for its own stacked panels. */
const backdropState = (active: boolean) =>
  active
    ? 'opacity-100 scale-100 translate-y-0'
    : 'pointer-events-none opacity-0 scale-[0.98] translate-y-1';

/*
 * Wording and media on this page come from src/data/home.json, edited under
 * Site content -> Home page. The brand toggle, collection previews, client
 * marquee and testimonials render themselves from the catalogue and their own
 * data, so they are not duplicated as fields.
 */
---

<BaseLayout title="Kelme & Adidas Team Sportswear Distributor" description={site.description}>
  {/* Viewport minus the sticky header, so it fills exactly one screen. The
      trailing 1px is the header's bottom border. */}
  <section
    class="relative flex min-h-[calc(100svh-4rem-1px)] items-center overflow-hidden bg-ink lg:min-h-[calc(100svh-5rem-1px)]"
  >
    <HeroPhotoWall products={products} />

    {/* Two scrims: one to knock the photos back, one to hold the text side. */}
    <div class="absolute inset-0 bg-ink/40"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/80 to-ink/10"></div>

    <div class="shell relative z-10 py-20">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-[0.2em] text-accent-500 uppercase">
          {site.tagline}
        </p>
        <h1
          class="mt-5 text-4xl font-bold tracking-tight text-balance text-white sm:text-5xl lg:text-6xl"
        >
          {hero.title}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-300">{hero.body}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          {hero.primaryLabel && <Button href={hero.primaryHref}>{hero.primaryLabel}</Button>}
          {hero.secondaryLabel && (
            <Button href={hero.secondaryHref} variant="inverted">{hero.secondaryLabel}</Button>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-white/10 bg-ink">
    <dl class="shell grid grid-cols-2 gap-x-8 gap-y-10 py-12 lg:grid-cols-4">
      {
        highlights.map((item) => (
          <div>
            <dt class="text-base font-semibold text-white">{item.value}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-neutral-400">{item.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* Intro and brand toggle sit side by side on large screens so the whole
      section fits one viewport, with no scrolling to reach either brand.
      The gradient + glows run full-bleed behind the shell so the section
      reads as a designed surface instead of white space either side of a
      narrow column. */}
  <section class="relative overflow-hidden bg-gradient-to-br from-neutral-50 via-white to-white dark:from-neutral-900 dark:via-neutral-950 dark:to-neutral-950">
    {/* Back-most layer: a running wall of the selected brand's logo, swapped
        by BrandShowcase's own tab script via `data-brand-page-backdrop`. */}
    {
      previews.map((preview, index) => (
        <div
          data-brand-page-backdrop={preview.brand}
          class:list={['absolute inset-0 transition-all duration-300 ease-out motion-reduce:transition-none', backdropState(index === 0)]}
        >
          <LogoMarqueeBackdrop
            src={BRAND_PROFILES[preview.brand].backdropMark}
            rows={7}
            tone="dark"
            opacity={preview.brand === 'Adidas' ? 0.28 : 0.12}
          />
        </div>
      ))
    }

    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-32 -left-24 h-80 w-80 rounded-full bg-accent-500/10 blur-3xl dark:bg-accent-500/10"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-1/3 -right-32 h-[28rem] w-[28rem] rounded-full bg-accent-500/15 blur-3xl dark:bg-accent-500/10"
    >
    </div>

    <div class="shell relative z-10 flex min-h-[calc(100svh-4rem-1px)] flex-col justify-center py-16 lg:min-h-[calc(100svh-5rem-1px)] lg:max-w-7xl lg:py-10">
      <BrandShowcase previews={previews} />
    </div>
  </section>

  <section class="shell pb-16 sm:pb-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow={collections.eyebrow}
        title={collections.title}
        description={collections.description}
      />
      {collections.buttonLabel && (
        <Button href={collections.buttonHref} variant="secondary">{collections.buttonLabel}</Button>
      )}
    </div>

    <div class="mt-10">
      <CollectionPreview previews={previews} />
    </div>
  </section>

  <section class="border-t border-neutral-200 py-16 sm:py-20 dark:border-neutral-800">
    <div class="shell">
      <SectionHeading
        eyebrow={trusted.eyebrow}
        title={trusted.title}
        description={trusted.description}
        align="center"
      />
    </div>
    <div class="shell mt-12">
      <ClientMarquee />
    </div>

    <div class="shell mt-16">
      <SectionHeading eyebrow={stories.eyebrow} title={stories.title} align="center" />
      <div class="mt-10">
        <Testimonials />
      </div>
    </div>

    <div class="shell mt-16">
      <p class="text-xs font-semibold tracking-[0.2em] text-neutral-500 uppercase dark:text-neutral-400">
        {gallery.heading}
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          /*
           * One list covering both photos and clips. A tile renders whichever
           * it has, video first, so switching a photo for a clip is a matter
           * of filling in one field rather than moving the tile somewhere
           * else. Shape is chosen per tile because the grid deliberately
           * mixes square, portrait and tall.
           */
          gallery.tiles.map((tile) => (
            <div
              class:list={[
                TILE_ASPECT[tile.shape],
                'overflow-hidden rounded-2xl',
                tile.video ? 'bg-black' : 'bg-neutral-100 dark:bg-neutral-800',
              ]}
            >
              {tile.video ? (
                tile.loops ? (
                  <video
                    class="h-full w-full object-cover"
                    src={tile.video}
                    aria-label={tile.alt}
                    autoplay
                    muted
                    loop
                    playsinline
                  />
                ) : (
                  /* preload="metadata" so a long clip costs a poster frame, not the file. */
                  <video
                    class="h-full w-full object-cover"
                    src={tile.video}
                    aria-label={tile.alt}
                    controls
                    preload="metadata"
                    playsinline
                  />
                )
              ) : (
                <RemoteImage
                  src={tile.image!}
                  alt={tile.alt}
                  widths={[300, 600]}
                  sizes="(min-width: 640px) 25vw, 90vw"
                  class="h-full w-full object-cover"
                />
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-ink">
    <div class="shell flex flex-wrap items-center justify-between gap-8 py-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-balance text-white sm:text-3xl">
          {closing.title}
        </h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-neutral-400">{closing.body}</p>
      </div>
      {closing.buttonLabel && (
        <Button href={closing.buttonHref} variant="inverted">{closing.buttonLabel}</Button>
      )}
    </div>
  </section>
</BaseLayout>
