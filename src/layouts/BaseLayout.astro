---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import logoIcon from '../assets/brand/logo-icon.png';
import { site } from '../config/site';
import { buildGraph } from '../lib/schema';

interface Props {
  /** Without the site name — the layout appends it. */
  title: string;
  description: string;
  /** Site-relative or absolute URL for social previews. */
  image?: string;
  /**
   * Set false when the title already names the company, so the home page does
   * not read "… | Amalia Utama" after already having said so.
   */
  appendSiteName?: boolean;
  /** Keeps a page out of search results — used by the 404 page. */
  noindex?: boolean;
  /**
   * Extra JSON-LD nodes describing this page specifically, e.g. the Product on
   * a detail page. The Organization and WebSite nodes are added for every page
   * and should not be repeated here.
   */
  schema?: readonly Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/og-default.png',
  appendSiteName = true,
  noindex = false,
  schema = [],
} = Astro.props;

const pageTitle = appendSiteName ? `${title} | ${site.name}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const socialImage = new URL(image, Astro.site ?? site.url);

/*
 * Google wants a real logo file for the Organization markup, not a favicon.
 * The source is a 107 KB PNG in src/assets, so it goes through the same
 * pipeline as every other image rather than being linked at full size.
 */
const logo = await getImage({ src: logoIcon, width: 512, format: 'png' });
const jsonLd = buildGraph(logo.src, schema);

/*
 * Defaults are index,follow — stating them costs one line and removes any
 * doubt. The max-* directives are the useful part: without them Google caps
 * image previews to a thumbnail and snippets to its own default length, which
 * for a catalogue means product photos do not show at full size in results.
 */
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang={site.language} class="scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.language.replace('-', '_')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {/* Machine-readable identity. See src/lib/schema.ts for what and why. */}
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-neutral-900 focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
