---
import Button from './Button.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { WEB3FORMS_ACCESS_KEY, contact, isContactFormEnabled, site } from '../config/site';
import { generalEnquiryUrl } from '../lib/whatsapp';

/*
 * Google Ads conversion for a completed enquiry.
 *
 * With no JavaScript the form posts natively and Web3Forms shows its own
 * confirmation page, unchanged. When both the Ads ID and the contact label are
 * set, the inline script below progressively enhances it: the submit is sent by
 * fetch so the visitor stays on the page, and the conversion fires only once
 * Web3Forms confirms the message was accepted.
 */
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const gadsContactLabel = import.meta.env.PUBLIC_GADS_CONTACT_LABEL;
const conversionTracking = Boolean(googleAdsId && gadsContactLabel);

/**
 * Native form post to Web3Forms — no JavaScript. The browser submits directly
 * and Web3Forms renders its own confirmation page, keeping the site static.
 *
 * Until an access key is set in /admin the form is not rendered at all: a form
 * that accepts a message and quietly drops it is worse than no form, so the
 * real contact channels are shown instead.
 */
const fields = [
  { name: 'name', label: 'Name', type: 'text', autocomplete: 'name', required: true },
  { name: 'organisation', label: 'Club / company', type: 'text', autocomplete: 'organization', required: false },
  { name: 'email', label: 'Email', type: 'email', autocomplete: 'email', required: true },
  { name: 'phone', label: 'Phone / WhatsApp', type: 'tel', autocomplete: 'tel', required: false },
] as const;

const inputClass =
  'mt-2 block w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-900 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:placeholder:text-neutral-500 dark:focus:border-white';
---

{
  !isContactFormEnabled ? (
    <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-900">
      <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        The enquiry form is not switched on yet. In the meantime, WhatsApp is the fastest way to
        reach us, or send an email and we will reply within one business day.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <Button href={generalEnquiryUrl()} external>
          <WhatsAppIcon />
          Chat on WhatsApp
        </Button>
        <Button href={`mailto:${contact.email}`} variant="secondary">
          Email us
        </Button>
      </div>
    </div>
  ) : (
    <Fragment>
    <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value={`New enquiry from ${site.name} website`} />
  <input type="hidden" name="from_name" value={site.name} />

  {/* Web3Forms honeypot: real users never see or fill this. */}
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="grid gap-5 sm:grid-cols-2">
    {
      fields.map((field) => (
        <div>
          <label for={field.name} class="text-sm font-medium text-neutral-900 dark:text-white">
            {field.label}
            {!field.required && <span class="ml-1 text-neutral-400 dark:text-neutral-500">(optional)</span>}
          </label>
          <input
            id={field.name}
            name={field.name}
            type={field.type}
            autocomplete={field.autocomplete}
            required={field.required}
            class={inputClass}
          />
        </div>
      ))
    }
  </div>

  <div>
    <label for="message" class="text-sm font-medium text-neutral-900 dark:text-white">Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      placeholder="Tell us the products, quantities and sizes you need."
      class={inputClass}></textarea>
  </div>

  <Button type="submit">Send enquiry</Button>

      <p class="text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
        Submitting this form sends your message to our inbox via Web3Forms. For a faster reply,
        message us on WhatsApp.
      </p>
    </form>
    {conversionTracking && (
      <Fragment>
        <div
          id="contact-form-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden
          class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6 text-sm leading-relaxed text-neutral-700 focus:outline-none dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300"
        />
        <script
          is:inline
          set:html={`
            (function () {
              var form = document.getElementById('contact-form');
              var status = document.getElementById('contact-form-status');
              if (!form || !status) return;

              form.addEventListener('submit', function (event) {
                event.preventDefault();
                var button = form.querySelector('button[type="submit"]');
                var payload = JSON.stringify(Object.fromEntries(new FormData(form).entries()));

                if (button) button.disabled = true;
                status.hidden = true;

                fetch(form.action, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                  body: payload,
                })
                  .then(function (response) { return response.json(); })
                  .then(function (result) {
                    if (result.success) {
                      if (typeof gtag === 'function') {
                        gtag('event', 'conversion', { send_to: ${JSON.stringify(`${googleAdsId}/${gadsContactLabel}`)} });
                      }
                      form.reset();
                      form.hidden = true;
                      status.textContent = 'Thank you — your enquiry is on its way. We will reply within one business day.';
                      status.hidden = false;
                      status.focus();
                    } else {
                      if (button) button.disabled = false;
                      status.textContent = (result && result.message) || 'Something went wrong. Please try again, or message us on WhatsApp.';
                      status.hidden = false;
                    }
                  })
                  .catch(function () {
                    if (button) button.disabled = false;
                    status.textContent = 'Could not send just now. Please try again, or message us on WhatsApp.';
                    status.hidden = false;
                  });
              });
            })();
          `}
        />
      </Fragment>
    )}
    </Fragment>
  )
}
