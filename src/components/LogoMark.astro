---
/**
 * Inlined so the charcoal strokes can follow `currentColor` and sit on either
 * a light or a dark background — an <img> cannot, since currentColor does not
 * cross the document boundary.
 *
 * TRACED APPROXIMATION rebuilt from a raster reference. Replace the paths here
 * and in `public/brand/logo-mark.svg` (the favicon) with the official vector
 * artwork before launch.
 */
interface Props {
  class?: string;
}

const { class: className = 'h-9 w-auto lg:h-10' }: Props = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 100 84"
  fill="none"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <g fill="currentColor">
    <path d="M49.8 0 55.5 9.6 11.5 83.7 0 83.7Z" />
    <path d="M58.7 15.6 63.9 24.3 28.6 83.7 18.2 83.7Z" />
    <path d="M67.6 29.8 99.7 83.7 87.9 83.7 61.7 39.7Z" />
  </g>
  <path fill="#0B6B47" d="M58.7 44.6 82 83.7 71.4 83.7 53.4 53.5Z" />
</svg>
