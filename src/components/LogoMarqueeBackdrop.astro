---
/**
 * A faint, multi-row wall of a single mark scrolling horizontally — a
 * decorative texture for a section's back-most layer. Rows alternate
 * direction. `repeat` defaults high on purpose: the loop is two copies of
 * `repeat` items translated by exactly 50%, so if a doubled row is narrower
 * than the viewport there's a visible gap where the strip runs out before
 * looping — a generous repeat count keeps it continuous on any screen width.
 * Purely decorative: `aria-hidden` and excluded from layout via `absolute`.
 *
 * Pass either `src` (an image mark) or `text` (a wordmark rendered as type) —
 * not both.
 */
interface Props {
  src?: string;
  text?: string;
  rows?: number;
  /** Copies per row before the loop repeats — keep generous, see above. */
  repeat?: number;
  /**
   * Image marks only. The source art is white. Set this when the backdrop
   * sits on a background that flips light/dark with the site theme (as
   * opposed to a literal-dark surface like `bg-ink`, which stays dark either
   * way) so the mark stays visible in light mode and reverts to white in
   * dark mode.
   */
  invertForLightBg?: boolean;
  class?: string;
}

const { src, text, rows = 3, repeat = 16, invertForLightBg = false, class: className }: Props = Astro.props;

const rowIndexes = Array.from({ length: rows }, (_, index) => index);
/** Rendered twice per row so the horizontal loop has no seam. */
const COPIES = [0, 1] as const;
---

<div
  aria-hidden="true"
  class:list={['pointer-events-none absolute inset-0 flex flex-col justify-center gap-8 overflow-hidden', className]}
>
  {
    rowIndexes.map((row) => (
      <div class="marquee marquee--left">
        <div
          class="marquee__track"
          style={`--marquee-duration: ${28 + row * 8}s; animation-direction: ${row % 2 ? 'reverse' : 'normal'};`}
        >
          {COPIES.map(() => (
            <ul class="marquee__row">
              {Array.from({ length: repeat }).map(() =>
                text ? (
                  <li class="shrink-0 text-4xl font-black tracking-tight whitespace-nowrap text-neutral-900 opacity-[0.12] sm:text-6xl dark:text-white">
                    {text}
                  </li>
                ) : (
                  <li class="shrink-0">
                    <img
                      src={src}
                      alt=""
                      width="120"
                      height="40"
                      class:list={[
                        'h-12 w-auto opacity-[0.12] sm:h-16',
                        invertForLightBg && 'invert dark:invert-0',
                      ]}
                    />
                  </li>
                ),
              )}
            </ul>
          ))}
        </div>
      </div>
    ))
  }
</div>
