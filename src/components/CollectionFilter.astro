---
import type { Brand, Category, Sport } from '../config/catalog';

interface Props {
  brands: Brand[];
  categories: Category[];
  /** Same set offered under every category. */
  sports: Sport[];
  total: number;
}

const { brands, categories, sports, total } = Astro.props;

const BUTTON =
  'rounded-full border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:border-neutral-900 aria-pressed:border-neutral-900 aria-pressed:bg-neutral-900 aria-pressed:text-white dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-white dark:aria-pressed:border-white dark:aria-pressed:bg-white dark:aria-pressed:text-neutral-900';

/** One group per top-level filter dimension; `all` is that dimension's reset option. */
const groups = [
  { key: 'brand', label: 'Brand', allLabel: 'All brands', values: brands },
  { key: 'category', label: 'Category', allLabel: 'All categories', values: categories },
] as const;
---

<div class="flex flex-col gap-6 sm:flex-row sm:flex-wrap sm:gap-10">
  {
    groups.map((group) => (
      <div role="group" aria-label={`Filter by ${group.label.toLowerCase()}`}>
        <p class="text-xs font-semibold tracking-[0.2em] text-neutral-500 uppercase dark:text-neutral-400">{group.label}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {['all', ...group.values].map((value) => (
            <button type="button" data-filter={group.key} data-value={value} aria-pressed={value === 'all' ? 'true' : 'false'} class={BUTTON}>
              {value === 'all' ? group.allLabel : value}
            </button>
          ))}
        </div>
      </div>
    ))
  }
</div>

{/* Same sport options for every category — revealed once any specific category is picked. */}
<div
  role="group"
  aria-label="Filter by sport"
  data-sport-panel
  hidden
  class="mt-6 transition-all duration-200 ease-out motion-reduce:transition-none"
>
  <p class="text-xs font-semibold tracking-[0.2em] text-neutral-500 uppercase dark:text-neutral-400">Sport</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {['all', ...sports].map((value) => (
      <button type="button" data-filter="sport" data-value={value} aria-pressed={value === 'all' ? 'true' : 'false'} class={BUTTON}>
        {value === 'all' ? 'All sports' : value}
      </button>
    ))}
  </div>
</div>

<p data-result-count aria-live="polite" class="mt-8 text-sm text-neutral-500 dark:text-neutral-400">
  Showing {total} of {total} products
</p>

<script>
  type Dimension = 'brand' | 'category' | 'sport';

  const ALL = 'all';

  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((catalog) => {
    const buttons = catalog.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = catalog.querySelectorAll<HTMLElement>('[data-product-item]');
    const emptyState = catalog.querySelector<HTMLElement>('[data-empty-state]');
    const resultCount = catalog.querySelector<HTMLElement>('[data-result-count]');
    const sportPanel = catalog.querySelector<HTMLElement>('[data-sport-panel]');

    const selection: Record<Dimension, string> = { brand: ALL, category: ALL, sport: ALL };

    // Lets links like `/collections?brand=Kelme` land pre-filtered.
    const requested = new URLSearchParams(window.location.search);
    (Object.keys(selection) as Dimension[]).forEach((dimension) => {
      const value = requested.get(dimension);
      const isValidOption = [...buttons].some(
        (button) => button.dataset.filter === dimension && button.dataset.value === value,
      );
      if (value && isValidOption) selection[dimension] = value;
    });

    const matches = (item: HTMLElement) =>
      (selection.brand === ALL || item.dataset.brand === selection.brand) &&
      (selection.category === ALL || item.dataset.category === selection.category) &&
      (selection.sport === ALL || item.dataset.sport === selection.sport);

    /** The sport panel only makes sense once a specific category is active. */
    const syncSportPanel = () => {
      if (!sportPanel) return;

      const active = selection.category !== ALL;
      sportPanel.hidden = !active;

      if (!active && selection.sport !== ALL) selection.sport = ALL;
    };

    const render = () => {
      let visible = 0;

      items.forEach((item) => {
        const shown = matches(item);
        item.hidden = !shown;
        if (shown) visible += 1;
      });

      buttons.forEach((button) => {
        const dimension = button.dataset.filter as Dimension;
        button.setAttribute('aria-pressed', String(selection[dimension] === button.dataset.value));
      });

      if (emptyState) emptyState.hidden = visible > 0;
      if (resultCount) {
        resultCount.textContent = `Showing ${visible} of ${items.length} products`;
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const dimension = button.dataset.filter as Dimension;
        const value = button.dataset.value ?? ALL;

        selection[dimension] = value;
        if (dimension === 'category') {
          // Switching category invalidates whatever sport was picked before.
          selection.sport = ALL;
          syncSportPanel();
        }
        render();
      });
    });

    syncSportPanel();
    render();
  });
</script>
