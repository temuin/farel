---
import { navLinks, site } from '../config/site';
import { generalEnquiryUrl } from '../lib/whatsapp';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/90 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/90">
  <div class="shell flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" aria-label={`${site.name} — home`}>
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors',
              isActive(link.href)
                ? 'text-accent-600 dark:text-accent-500'
                : 'text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={generalEnquiryUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-700 sm:inline-flex"
      >
        <WhatsAppIcon />
        WhatsApp
      </a>

      <ThemeToggle />

      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-neutral-300 text-neutral-900 lg:hidden dark:border-neutral-700 dark:text-white"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Main" hidden class="border-t border-neutral-200 bg-white lg:hidden dark:border-neutral-800 dark:bg-neutral-950">
    <ul class="shell flex flex-col py-2">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'block py-3 text-base font-medium',
                isActive(link.href) ? 'text-accent-600 dark:text-accent-500' : 'text-neutral-700 dark:text-neutral-300',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="py-3 sm:hidden">
        <a
          href={generalEnquiryUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white"
        >
          <WhatsAppIcon />
          Chat on WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-nav');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.hidden = isOpen;
    });
  }
</script>
