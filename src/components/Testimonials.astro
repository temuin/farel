---
import { testimonials } from '../config/testimonials';
import { toEmbedUrl } from '../lib/video';

/** Two-letter monogram for the avatar chip, e.g. "Garuda Karya" -> "GK". */
const initials = (organisation: string) =>
  organisation
    .split(' ')
    .map((word) => word[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<div class="grid gap-6 sm:grid-cols-3">
  {
    testimonials.map((testimonial) => (
      <figure class="flex h-full flex-col rounded-2xl border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-900">
        {/* Only rendered once the client attaches a video in the CMS. */}
        {toEmbedUrl(testimonial.videoUrl) && (
          <div class="mb-5 aspect-video overflow-hidden rounded-xl bg-neutral-200 dark:bg-neutral-800">
            <iframe
              src={toEmbedUrl(testimonial.videoUrl)}
              title={`Testimonial from ${testimonial.organisation}`}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="h-full w-full"
              style="border:0"
            />
          </div>
        )}

        <div aria-hidden="true" class="flex gap-0.5 text-accent-500 dark:text-accent-500">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.8L10 1.5z" />
            </svg>
          ))}
        </div>

        <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">
          &ldquo;{testimonial.quote}&rdquo;
        </blockquote>

        <figcaption class="mt-6 flex items-center gap-3 border-t border-neutral-200 pt-4 dark:border-neutral-800">
          {testimonial.logo ? (
            <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white ring-1 ring-neutral-200 dark:ring-neutral-800">
              <img
                src={testimonial.logo}
                alt={`${testimonial.organisation} logo`}
                loading="lazy"
                class="h-full w-full object-contain p-1"
              />
            </span>
          ) : (
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent-50 text-sm font-bold text-accent-600 dark:bg-accent-500/10 dark:text-accent-500">
              {initials(testimonial.organisation)}
            </span>
          )}
          <div>
            <p class="text-sm font-semibold text-neutral-900 dark:text-white">{testimonial.role}</p>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">{testimonial.organisation}</p>
          </div>
        </figcaption>
      </figure>
    ))
  }
</div>
