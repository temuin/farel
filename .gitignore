# build output
dist/
# generated types
.astro/

# local Cloudflare Pages dev cache (wrangler pages dev)
.wrangler/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local-only Claude Code permissions (machine-specific, not for sharing)
.claude/settings.local.json

# Video files live in the R2 bucket, not the repository -- they are tens of MB
# each and Cloudflare Pages rejects any single file over 25 MB. Poster images
# stay tracked. Set MEDIA_BASE_URL to the bucket host at build time.
public/videos/*.mp4
media-upload/
