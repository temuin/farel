# Google Ads conversion tracking.
#
# Leave PUBLIC_GOOGLE_ADS_ID unset to omit the gtag.js snippet entirely — no
# third-party script ships when it is blank. Each event name gates its own
# conversion, so tracking can be rolled out one action at a time.

# Google Ads conversion ID, format AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_ID=

# Conversion event name fired after a successful contact-form submission.
# From the conversion action's "Install the tag yourself" snippet, e.g.
# ads_conversion_Contact_Us_1
PUBLIC_GADS_CONTACT_EVENT=

# Conversion event name fired on WhatsApp (wa.me) and tel: link clicks,
# e.g. ads_conversion_WhatsApp_1
PUBLIC_GADS_WHATSAPP_EVENT=
