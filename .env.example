# Google Ads conversion tracking.
#
# Leave PUBLIC_GOOGLE_ADS_ID unset to omit the gtag.js snippet entirely — no
# third-party script ships when it is blank. Each label gates its own
# conversion event, so tracking can be rolled out one action at a time.

# Google Ads conversion ID, format AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_ID=

# Conversion label fired after a successful contact-form submission
PUBLIC_GADS_CONTACT_LABEL=

# Conversion label fired on WhatsApp (wa.me) and tel: link clicks
PUBLIC_GADS_WHATSAPP_LABEL=
