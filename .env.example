# Google Ads conversion tracking.
#
# Leave PUBLIC_GOOGLE_ADS_ID unset to omit the gtag.js snippet entirely — no
# third-party script ships when it is blank. Each of the other two vars gates
# its own conversion, so tracking can be rolled out one action at a time.

# Google Ads conversion ID, format AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_ID=

# Conversion event name fired after a successful contact-form submission.
# From a "page load" conversion action's snippet, e.g. ads_conversion_Contact_Us_1
PUBLIC_GADS_CONTACT_EVENT=

# Full send_to target fired on WhatsApp (wa.me) and tel: link clicks.
# From a "click" conversion action's snippet, e.g. AW-XXXXXXXXX/AbC-D_efGhIJ
PUBLIC_GADS_WHATSAPP_SEND_TO=
